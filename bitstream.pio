; @brief Bitstream PIO program

.pio_version 0

.program scoreboard_bitstream_tx
.wrap_target
    set pins, 1 ; Start code-point
    out pins, 1 ; Shift out code-point value
    nop         ; Hold value
    out pins, 1 ; End code-point (This will be 0 for a normal code, and 1 for restart)
.wrap

% c-sdk {
#include "hardware/clocks.h"
static inline void scoreboard_bitstream_tx_program_init(PIO pio, uint sm, uint offset, uint pin, uint baudrate)
{
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_gpio_init(pio, pin);
    pio_sm_config c = scoreboard_bitstream_tx_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_out_pins(&c, pin, 1);

    /* Shift OSR to the left, autopull at 32 bits */
    sm_config_set_out_shift(&c, false, true, 32);

    /* Double FIFO TX buffer length since FIFO RX buffer is not needed */
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    /* Transmit 1 bit every clock cycle */
    double div = ((double)clock_get_hz(clk_sys)) / ((double)(1 * baudrate));
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
